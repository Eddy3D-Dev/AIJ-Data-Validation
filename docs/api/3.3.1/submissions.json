 "description": "Every solver submitted under submissions/ in the repository, scored by this build from the values it gave at the published points (cases/{id}/probes.csv). The inputs are self-reported; the scoring is this repository's, the same metrics and conventions as Eddy3D's results in validation.json. A submission scores the points it gave: `coverage` says how many of the measured points that is.",
 "how_to_submit": "https://aij.eddy3d.com/byos/",
 "status_meaning": {
  "scored": "the submission gave values for this case and they were scored"
 },
 "metric_meaning": {
  "Count": "number of measured points scored",
  "MeanObserved": "mean of the measured, normalised quantity",
  "MeanPredicted": "mean of the modelled, normalised quantity",
  "Fb": "fractional bias, 2 (mean_obs - mean_pred) / (mean_obs + mean_pred); positive = model low",
  "Nmse": "normalised mean square error",
  "Nad": "normalised absolute difference",
  "Fac2": "fraction of points within a factor of two (harsh near zero for sign-changing V and W)",
  "HitRate": "fraction of points within D = 0.25 relative or W = 0.05 U_H absolute",
  "Mg": "geometric mean bias",
  "Vg": "geometric variance",
  "GeometricPairs": "pairs with both values positive (used for Mg/Vg)",
  "R": "Pearson correlation coefficient",
  "null": "a metric that is undefined for the data (for example Mg and Vg when no pair has both values positive; Fb, Nmse and Nad of a signed velocity component of Case H or I whose observed and predicted means are not both positive)"
 },
