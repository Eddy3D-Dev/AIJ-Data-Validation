{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://eddy3d-dev.github.io/AIJ-Data-Validation/api/3.2.1/schemas/index.schema.json",
 "title": "API index",
 "description": "Every endpoint and file, versions, compatibility policy, changelog, licence and citation.",
 "type": "object",
 "required": [
  "$schema",
  "schema_version",
  "data_version",
  "license",
  "name",
  "base_url",
  "tree",
  "release_base_url",
  "versions_url",
  "versions",
  "endpoints",
  "case_ids",
  "files",
  "changelog",
  "cite"
 ],
 "properties": {
  "$schema": {
   "type": "string",
   "format": "uri"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "description": "the API's version (semantic versioning); see index.json changelog"
  },
  "data_version": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "SHA-256 over every served measurement, geometry and score file; changes when, and only when, the data does"
  },
  "license": {
   "const": "CC-BY-4.0",
   "description": "SPDX identifier of the data's licence"
  },
  "name": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "base_url": {
   "type": "string",
   "format": "uri",
   "description": "the root of this tree: every URL in the tree's documents starts with it"
  },
  "tree": {
   "enum": [
    "release",
    "latest"
   ],
   "description": "'release': a frozen copy of one release under `/api/<release>/`, which never changes; 'latest': the unversioned `/api/` alias, which always equals the newest release"
  },
  "release_base_url": {
   "type": "string",
   "format": "uri",
   "description": "the frozen copy of `versions.release`: equal to base_url in a release tree, the pinned address of this release in the latest alias"
  },
  "versions_url": {
   "type": "string",
   "format": "uri",
   "description": "versions.json, the list of every release (always at the unversioned /api/ path)"
  },
  "fallback_base_url": {
   "type": "string",
   "format": "uri"
  },
  "fallback_note": {
   "type": "string"
  },
  "repository": {
   "type": "string",
   "format": "uri"
  },
  "site": {
   "type": "string",
   "format": "uri"
  },
  "versions": {
   "type": "object",
   "required": [
    "release",
    "schema",
    "data"
   ],
   "properties": {
    "release": {
     "type": "string",
     "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "schema": {
     "type": "string",
     "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "data": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "clean_manifest": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "release": {
   "type": "object",
   "required": [
    "version",
    "date",
    "tag",
    "url",
    "base_url",
    "changelog"
   ],
   "properties": {
    "version": {
     "type": "string",
     "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "date": {
     "type": "string",
     "format": "date"
    },
    "tag": {
     "type": "string",
     "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "base_url": {
     "type": "string",
     "format": "uri",
     "description": "the raw files of this release's frozen copy, at the release tag"
    },
    "changelog": {
     "type": "string",
     "format": "uri"
    }
   }
  },
  "compatibility": {
   "type": "string"
  },
  "caching": {
   "type": "string"
  },
  "changelog": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "version",
     "date",
     "changes"
    ],
    "properties": {
     "version": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "changes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "endpoints": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "method",
     "media_type",
     "description",
     "templated"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "templated": {
      "type": "boolean"
     },
     "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^[^{}]*$"
     },
     "urls": {
      "type": "array",
      "items": {
       "type": "string",
       "format": "uri",
       "pattern": "^[^{}]*$"
      },
      "minItems": 1
     },
     "method": {
      "const": "GET"
     },
     "media_type": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "schema": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "if": {
     "properties": {
      "templated": {
       "const": true
      }
     }
    },
    "then": {
     "required": [
      "urls"
     ],
     "not": {
      "required": [
       "url"
      ]
     }
    },
    "else": {
     "required": [
      "url"
     ],
     "not": {
      "required": [
       "urls"
      ]
     }
    }
   }
  },
  "case_ids": {
   "type": "array",
   "items": {
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "E",
     "F",
     "G",
     "H",
     "I",
     "J",
     "K",
     "L",
     "M"
    ]
   }
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "url",
     "path",
     "media_type",
     "bytes",
     "sha256"
    ],
    "properties": {
     "url": {
      "type": "string",
      "format": "uri",
      "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
     },
     "path": {
      "type": "string",
      "description": "path below the API base"
     },
     "media_type": {
      "type": "string"
     },
     "bytes": {
      "type": "integer",
      "minimum": 0
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "license_detail": {
   "type": "object",
   "required": [
    "spdx",
    "url"
   ],
   "properties": {
    "spdx": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "cite": {
   "type": "object",
   "required": [
    "api",
    "benchmark"
   ],
   "properties": {
    "benchmark": {
     "type": "string"
    },
    "guidelines": {
     "type": "string"
    },
    "per_case": {
     "type": "string"
    },
    "api": {
     "type": "object",
     "required": [
      "title",
      "version",
      "url",
      "release_url",
      "doi",
      "apa",
      "bibtex",
      "csl_json"
     ],
     "properties": {
      "title": {
       "type": "string"
      },
      "version": {
       "type": "string",
       "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
      },
      "url": {
       "type": "string",
       "format": "uri",
       "description": "the pinned address of this release's API: the address to cite"
      },
      "release_url": {
       "type": "string",
       "format": "uri",
       "description": "the release's page in the repository"
      },
      "doi": {
       "type": [
        "string",
        "null"
       ],
       "description": "the DOI of the release's Zenodo record; null until one exists"
      },
      "apa": {
       "type": "string"
      },
      "bibtex": {
       "type": "string"
      },
      "csl_json": {
       "type": "object",
       "description": "the same citation as a CSL-JSON item"
      }
     }
    }
   }
  }
 }
}
