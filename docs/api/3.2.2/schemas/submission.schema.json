{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://eddy3d-dev.github.io/AIJ-Data-Validation/api/3.2.2/schemas/submission.schema.json",
 "title": "Submission",
 "description": "One submitted solver in full: its submission.yaml, and every score, coverage and group per case.",
 "type": "object",
 "required": [
  "$schema",
  "schema_version",
  "data_version",
  "license",
  "slug",
  "submission",
  "example",
  "provenance",
  "cases"
 ],
 "properties": {
  "$schema": {
   "type": "string",
   "format": "uri"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "description": "the API's version (semantic versioning); see index.json changelog"
  },
  "data_version": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "SHA-256 over every served measurement, geometry and score file; changes when, and only when, the data does"
  },
  "license": {
   "const": "CC-BY-4.0",
   "description": "SPDX identifier of the data's licence"
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
   "description": "a submission: the name of its folder under submissions/ in the repository"
  },
  "submission": {
   "type": "object"
  },
  "example": {
   "type": "boolean"
  },
  "provenance": {
   "type": "string"
  },
  "scored_with": {
   "type": "object"
  },
  "folder": {
   "type": "string",
   "format": "uri"
  },
  "page": {
   "type": "string",
   "format": "uri"
  },
  "cases": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "case",
     "status",
     "headline",
     "scores",
     "coverage",
     "groups",
     "values"
    ],
    "properties": {
     "case": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "E",
       "F",
       "G",
       "H",
       "I",
       "J",
       "K",
       "L",
       "M"
      ]
     },
     "title": {
      "type": "string"
     },
     "status": {
      "const": "scored"
     },
     "headline": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "scores": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "Count",
        "Fb",
        "R"
       ],
       "properties": {
        "Count": {
         "type": "integer",
         "minimum": 0
        },
        "MeanObserved": {
         "type": [
          "number",
          "null"
         ]
        },
        "MeanPredicted": {
         "type": [
          "number",
          "null"
         ]
        },
        "Fb": {
         "type": [
          "number",
          "null"
         ]
        },
        "Nmse": {
         "type": [
          "number",
          "null"
         ]
        },
        "Nad": {
         "type": [
          "number",
          "null"
         ]
        },
        "Fac2": {
         "type": [
          "number",
          "null"
         ]
        },
        "HitRate": {
         "type": [
          "number",
          "null"
         ]
        },
        "Mg": {
         "type": [
          "number",
          "null"
         ]
        },
        "Vg": {
         "type": [
          "number",
          "null"
         ]
        },
        "GeometricPairs": {
         "type": [
          "integer",
          "null"
         ]
        },
        "R": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     },
     "coverage": {
      "type": "object"
     },
     "groups": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "values": {
      "type": "object",
      "required": [
       "url",
       "path",
       "media_type",
       "bytes",
       "sha256"
      ],
      "properties": {
       "url": {
        "type": "string",
        "format": "uri",
        "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
       },
       "path": {
        "type": "string",
        "description": "path below the API base"
       },
       "media_type": {
        "type": "string"
       },
       "bytes": {
        "type": "integer",
        "minimum": 0
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     },
     "U_ref_m_s": {
      "type": [
       "number",
       "null"
      ]
     },
     "units_given": {
      "enum": [
       "normalised",
       "si"
      ]
     }
    }
   }
  }
 }
}
