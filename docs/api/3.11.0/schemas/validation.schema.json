{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://aij.eddy3d.com/api/3.11.0/schemas/validation.schema.json",
 "title": "Case validation",
 "description": "Eddy3D's scores against one case, per engine and run. An engine that is not 'scored' has no result here.",
 "type": "object",
 "required": [
  "$schema",
  "schema_version",
  "data_version",
  "license",
  "case",
  "status",
  "engines",
  "results"
 ],
 "properties": {
  "$schema": {
   "type": "string",
   "format": "uri"
  },
  "schema_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "description": "the API's version (semantic versioning); see index.json changelog"
  },
  "data_version": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "SHA-256 over every served measurement, geometry and score file; changes when, and only when, the data does"
  },
  "license": {
   "const": "CC-BY-4.0",
   "description": "SPDX identifier of the data's licence"
  },
  "case": {
   "enum": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "F",
    "G",
    "H",
    "I",
    "J",
    "K",
    "L",
    "M"
   ]
  },
  "title": {
   "type": "string"
  },
  "status": {
   "enum": [
    "scored",
    "pending"
   ]
  },
  "status_meaning": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "engines": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "engine",
     "status"
    ],
    "properties": {
     "engine": {
      "enum": [
       "openfoam12-realizableKE",
       "openfoam12-kEpsilon",
       "openfoam12-kOmegaSST",
       "umf-realizableKE",
       "umf-buoyantKEpsilon",
       "openlb",
       "fluidx3d",
       "ml-surrogate"
      ]
     },
     "status": {
      "enum": [
       "scored",
       "running",
       "pending",
       "not comparable"
      ]
     }
    }
   }
  },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "run_id",
     "engine",
     "configuration",
     "headline",
     "scores",
     "figures",
     "pairs",
     "source_url"
    ],
    "properties": {
     "run_id": {
      "type": "string"
     },
     "engine": {
      "enum": [
       "openfoam12-realizableKE",
       "openfoam12-kEpsilon",
       "openfoam12-kOmegaSST",
       "umf-realizableKE",
       "umf-buoyantKEpsilon",
       "openlb",
       "fluidx3d",
       "ml-surrogate"
      ]
     },
     "configuration": {
      "type": [
       "string",
       "null"
      ]
     },
     "quantity": {
      "type": [
       "string",
       "null"
      ]
     },
     "normalisation": {
      "type": "string"
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "headline": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "scores": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "Count",
        "Fb",
        "R"
       ],
       "properties": {
        "Count": {
         "type": "integer",
         "minimum": 0
        },
        "MeanObserved": {
         "type": [
          "number",
          "null"
         ]
        },
        "MeanPredicted": {
         "type": [
          "number",
          "null"
         ]
        },
        "Fb": {
         "type": [
          "number",
          "null"
         ]
        },
        "Nmse": {
         "type": [
          "number",
          "null"
         ]
        },
        "Nad": {
         "type": [
          "number",
          "null"
         ]
        },
        "Fac2": {
         "type": [
          "number",
          "null"
         ]
        },
        "HitRate": {
         "type": [
          "number",
          "null"
         ]
        },
        "Mg": {
         "type": [
          "number",
          "null"
         ]
        },
        "Vg": {
         "type": [
          "number",
          "null"
         ]
        },
        "GeometricPairs": {
         "type": [
          "integer",
          "null"
         ]
        },
        "R": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     },
     "figures": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "url",
        "caption"
       ],
       "properties": {
        "url": {
         "type": "string",
         "format": "uri"
        },
        "caption": {
         "type": "string"
        }
       }
      }
     },
     "pairs": {
      "anyOf": [
       {
        "type": "object",
        "required": [
         "url",
         "path",
         "media_type",
         "bytes",
         "sha256"
        ],
        "properties": {
         "url": {
          "type": "string",
          "format": "uri",
          "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
         },
         "path": {
          "type": "string",
          "description": "path below the API base"
         },
         "media_type": {
          "type": "string"
         },
         "bytes": {
          "type": "integer",
          "minimum": 0
         },
         "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         }
        }
       },
       {
        "type": "null"
       }
      ]
     },
     "pairs_columns": {
      "type": [
       "string",
       "null"
      ]
     },
     "reproduce": {
      "type": "string"
     },
     "source_file": {
      "type": "string"
     },
     "source_url": {
      "type": "string",
      "format": "uri"
     },
     "cite": {
      "type": "string"
     }
    }
   }
  },
  "grid_study": {
   "description": "the grid-convergence study of the OpenFOAM fixture; null where none was run",
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "engine",
      "configuration",
      "method",
      "band_meaning",
      "grids",
      "scores_on_each_grid",
      "bands_summary",
      "bands",
      "bands_columns",
      "figure",
      "source"
     ],
     "properties": {
      "engine": {
       "enum": [
        "openfoam12-realizableKE",
        "openfoam12-kEpsilon",
        "openfoam12-kOmegaSST",
        "umf-realizableKE",
        "umf-buoyantKEpsilon",
        "openlb",
        "fluidx3d",
        "ml-surrogate"
       ]
      },
      "served_cell_scale": {
       "type": "number"
      },
      "configuration": {
       "type": "string",
       "description": "what was solved: the served fixture with the eddy-viscosity cap lifted"
      },
      "method": {
       "type": "string"
      },
      "band_meaning": {
       "type": "string"
      },
      "grids": {
       "type": "array",
       "items": {
        "type": "object",
        "description": "cell_scale, cells (per state for Case E) and iterations of each mesh, coarse first"
       }
      },
      "refinement_ratios": {
       "description": "(N_fine/N_coarse)^(1/3) of each consecutive pair, per state for Case E"
      },
      "scores_on_each_grid": {
       "type": "object",
       "description": "headline label -> per mesh, coarse first: Fac2, Fb, HitRate and R, or null where that mesh was not scored",
       "additionalProperties": {
        "type": "array",
        "items": {
         "type": [
          "object",
          "null"
         ]
        }
       }
      },
      "recirculation_Lr_over_H": {
       "type": "array",
       "items": {
        "type": "number"
       }
      },
      "recirculation_Lr_over_H_extrapolated": {
       "type": "object"
      },
      "note": {
       "type": "string"
      },
      "bands_summary": {
       "type": "object",
       "description": "per quantity (and state): points, with_band, regimes, band_median, band_p90 and within_hit_rate_tolerance (bands at or below W = 0.05)"
      },
      "bands": {
       "type": "object",
       "required": [
        "url",
        "path",
        "media_type",
        "bytes",
        "sha256"
       ],
       "properties": {
        "url": {
         "type": "string",
         "format": "uri",
         "description": "absolute URL; the ?v= query is the file's SHA-256 prefix, so a changed file has a new URL"
        },
        "path": {
         "type": "string",
         "description": "path below the API base"
        },
        "media_type": {
         "type": "string"
        },
        "bytes": {
         "type": "integer",
         "minimum": 0
        },
        "sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      },
      "bands_columns": {
       "type": "string"
      },
      "figure": {
       "type": "object",
       "required": [
        "url",
        "caption"
       ],
       "properties": {
        "url": {
         "type": "string",
         "format": "uri"
        },
        "caption": {
         "type": "string"
        }
       }
      },
      "source": {
       "type": "object",
       "required": [
        "repository",
        "commit"
       ],
       "properties": {
        "repository": {
         "type": "string",
         "format": "uri"
        },
        "folder": {
         "type": "string"
        },
        "commit": {
         "type": "string"
        },
        "documentation": {
         "type": "string"
        }
       }
      }
     }
    }
   ]
  }
 }
}
